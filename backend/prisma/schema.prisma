generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  username       String?
  createdAt      DateTime        @default(now())
  password       String?
  googleId       String?         @unique
  allergies      Allergies[]
  photoUrl       String?
  pronouns       String?
  muscleGroups   MuscleGroups[]
  biometrics     Biometrics?
  DashboardDiet  DashboardDiet?
  DashboardSport DashboardSport?
}

model Biometrics {
  id             Int      @id @default(autoincrement())
  ownerId        Int      @unique
  height         Int
  activity       String
  age            Int
  c_weight       Int
  d_weight       Int
  genre          String
  goal           String
  weeks          Int
  createdAt      DateTime @default(now())
  imc            Float?
  kcalObjetivo   Int?
  macroCarbs     Int?
  macroGrasas    Int?
  macroProteinas Int?
  owner          User     @relation(fields: [ownerId], references: [id])
}

model Diet {
  id       Int      @id @default(autoincrement())
  title    String   @unique
  subtitle String
  image    String
  recipes  Recipe[]
}

model Recipe {
  id              Int            @id @default(autoincrement())
  dietId          Int?
  name            String         @unique
  image           String
  duration        Int
  calories        Int
  allergies       Allergies[]
  moment          Moment
  instructions    String
  ingredients     String[]
  macros          String[]
  dashboardDietId Int?
  dailyRecipesId  Int?
  DailyRecipes    DailyRecipes?  @relation(fields: [dailyRecipesId], references: [id])
  dashboardDiet   DashboardDiet? @relation(fields: [dashboardDietId], references: [id])
  diet            Diet?          @relation(fields: [dietId], references: [id])
}

model ExercisePlan {
  id        Int        @id @default(autoincrement())
  title     String     @unique
  subtitle  String
  image     String
  exercises Exercise[]
}

model Exercise {
  id               Int              @id @default(autoincrement())
  exercisePlanId   Int?
  name             String           @unique
  image            String
  difficulty       String
  level            Level
  muscles          MuscleGroups[]
  gif              String
  stats            Int[]
  duration         Int
  filters          FilterExercise[]
  dashboardSportId Int?
  dailyExercisesId Int?
  DailyExercises   DailyExercises?  @relation(fields: [dailyExercisesId], references: [id])
  DashboardSport   DashboardSport?  @relation(fields: [dashboardSportId], references: [id])
  exercisePlan     ExercisePlan?    @relation(fields: [exercisePlanId], references: [id])
}

model DashboardDiet {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  calories_goal  Int           @default(2500)
  calories_total Int           @default(0)
  protein        Int           @default(0)
  fats           Int           @default(0)
  carbs          Int           @default(0)
  water          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  DailyRecipes   DailyRecipes?
  User           User          @relation(fields: [userId], references: [id])
  recetas        Recipe[]
}

model DashboardSport {
  id             Int             @id @default(autoincrement())
  userId         Int             @unique
  week           Int[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now())
  calories       Int             @default(0)
  time           Int             @default(0)
  DailyExercises DailyExercises?
  User           User            @relation(fields: [userId], references: [id])
  Exercise       Exercise[]
}

model DailyExercises {
  id               Int            @id @default(autoincrement())
  date             DateTime       @default(now())
  dashboardSportId Int            @unique
  DashboardSport   DashboardSport @relation(fields: [dashboardSportId], references: [id])
  Exercise         Exercise[]
}

model DailyRecipes {
  id              Int           @id @default(autoincrement())
  date            DateTime      @default(now())
  dashboardDietId Int           @unique
  DashboardDiet   DashboardDiet @relation(fields: [dashboardDietId], references: [id])
  Recipe          Recipe[]
}

enum Allergies {
  huevos
  gluten
  lacteos
  crustaceos
  pescado
  frutos_secos
  cacahuete
  soja
  sesamo
}

enum AllergiesIcons {
  egg
  bakery_dining
  set_meal
  local_drink
  eco
}

enum Moment {
  DESAYUNO
  ALMUERZO
  CENA
}

enum Level {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADOS
}

enum FilterExercise {
  peso_corporal
  polea
  barra
  asistido
  pelota_pilates
  cuerda
  rodillo
  maquina_palanca
  mancuernas
  stationary_bike
  eliptica
  escaladora
  balon_medicinal
  banda_elastica
}

enum MuscleGroups {
  Piernas
  Cuadriceps
  Gemelos
  Espalda
  Dorsales
  Pecho
  Pectorales
  Gluteos
  Abdominales
  Cardio
  Hombros
  Espalda_alta
  Biceps
  Brazos
  Triceps
  Aductores
  Deltoides
  Core
  Isquiotibiales
  Columna
  Cuello
  Antebrazos
  Trapecios
}

enum Unit {
  kcal
  min
  hour
}
