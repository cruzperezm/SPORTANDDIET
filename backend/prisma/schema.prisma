// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  username   String?
  password   String?
  googleId   String?     @unique // <-- ¡ESTE ES EL QUE FALTA!
  biometrics Biometrics?
  createdAt  DateTime    @default(now())
}

model Biometrics {
  id       Int    @id @default(autoincrement())
  owner    User   @relation(fields: [ownerId], references: [id])
  ownerId  Int    @unique
  genre    String
  age      Int
  height   Int
  goal     String
  activity String
  c_weight Int
  d_weight Int
  weeks    Int
}

model Diet {
  id       Int      @id @default(autoincrement())
  title    String   @unique
  subtitle String
  image    String
  recipes  Recipe[]
}

enum Allergies {
  huevos
  gluten
  lacteos
  crustaceos
  pescado
  frutos_secos
  cacahuete
  soja
  sesamo
}

enum AllergiesIcons {
  egg
  bakery_dining
  set_meal
  local_drink
  eco
}

enum Moment {
  DESAYUNO
  ALMUERZO
  CENA
}

model Recipe {
  id           Int         @id @default(autoincrement())
  diet         Diet?       @relation(fields: [dietId], references: [id])
  dietId       Int?
  name         String      @unique
  image        String
  duration     Int
  calories     Int
  allergies    Allergies[]
  ingredients  String[]
  // Las macros se pondrán en orden Proteinas, Grasas, Carbos sin los títulos ni unidades
  macros       String[]
  moment       Moment
  instructions String
}

model ExercisePlan {
  id        Int        @id @default(autoincrement())
  title     String     @unique
  subtitle  String
  image     String
  exercises Exercise[]
}

enum Level {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADOS
}

enum FilterExercise {
  peso_corporal
  polea
  barra
  asistido
  pelota_pilates
  cuerda
  rodillo
  maquina_palanca
  mancuernas
  stationary_bike
  eliptica
  escaladora
  balon_medicinal
  banda_elastica
}

enum MuscleGroups {
  Piernas
  Cuadriceps
  Gemelos
  Espalda
  Dorsales
  Pecho
  Pectorales
  Gluteos
  Abdominales
  Cardio
  Hombros
  Espalda_alta
  Biceps
  Brazos
  Triceps
  Aductores
  Deltoides
  Core
  Isquiotibiales
  Columna
  Cuello
  Antebrazos
  Trapecios
}

model Exercise {
  id             Int              @id @default(autoincrement())
  exercisePlan   ExercisePlan?    @relation(fields: [exercisePlanId], references: [id])
  exercisePlanId Int?
  name           String           @unique
  image          String
  duration       Int
  difficulty     String
  level          Level
  filtros        FilterExercise[]
  muscles        MuscleGroups[]
  // Las stats se pondrán en orden Series (nº), repeticiones (nº), dencanso (s)
  stats          Int[]
  gif            String
}
