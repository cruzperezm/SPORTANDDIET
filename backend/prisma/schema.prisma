generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  username   String?
  createdAt  DateTime    @default(now())
  password   String?
  googleId   String?     @unique
  biometrics Biometrics?
  dashboards Dashboard[]
}

model Biometrics {
  id       Int    @id @default(autoincrement())
  ownerId  Int    @unique
  height   Int
  activity String
  age      Int
  c_weight Int
  d_weight Int
  genre    String
  goal     String
  weeks    Int
  owner    User   @relation(fields: [ownerId], references: [id])

  // --- NUEVOS CAMPOS AÑADIDOS ---
  imc            Float?
  kcalObjetivo   Int?
  macroProteinas Int?     // En gramos
  macroGrasas    Int?     // En gramos
  macroCarbs     Int?     // En gramos

  createdAt      DateTime @default(now())
}

model Diet {
  id       Int      @id @default(autoincrement())
  title    String   @unique
  subtitle String
  image    String
  recipes  Recipe[]
}

model Recipe {
  id              Int            @id @default(autoincrement())
  dietId          Int?
  name            String         @unique
  image           String
  duration        Int
  calories        Int
  allergies       Allergies[]
  moment          Moment
  instructions    String
  ingredients     String[]
  macros          String[]
  diet            Diet?          @relation(fields: [dietId], references: [id])
  dashboardDiet   DashboardDiet? @relation(fields: [dashboardDietId], references: [id])
  dashboardDietId Int?
}

model ExercisePlan {
  id        Int        @id @default(autoincrement())
  title     String     @unique
  subtitle  String
  image     String
  exercises Exercise[]
}

model Exercise {
  id             Int              @id @default(autoincrement())
  exercisePlanId Int?
  name           String           @unique
  image          String
  difficulty     String
  level          Level
  filters        FilterExercise[]
  muscles        MuscleGroups[]
  gif            String
  stats          Int[]
  duration       Int
  exercisePlan   ExercisePlan?    @relation(fields: [exercisePlanId], references: [id])
}

model DashboardDiet {
  id                Int         @id @default(autoincrement())
  calorias_objetivo Int
  calorias_totales  Int
  macros1           Int
  macros2           Int
  recetas           Recipe[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now())
  dashboards        Dashboard[]
}

model DashboardSport {
  id          Int         @id @default(autoincrement())
  actividades Int
  semana      Int
  ejercicios  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  dashboards  Dashboard[]
}

model Dashboard {
  id               Int            @id @default(autoincrement())
  user             User           @relation(fields: [userId], references: [id])
  userId           Int
  dieta            DashboardDiet  @relation(fields: [dashboardDietId], references: [id])
  dashboardDietId  Int
  deporte          DashboardSport @relation(fields: [dashboardSportId], references: [id])
  dashboardSportId Int
}

enum Allergies {
  huevos
  gluten
  lacteos
  crustaceos
  pescado
  frutos_secos
  cacahuete
  soja
  sesamo
}

enum AllergiesIcons {
  egg
  bakery_dining
  set_meal
  local_drink
  eco
}

enum Moment {
  DESAYUNO
  ALMUERZO
  CENA
}

enum Level {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADOS
}

enum FilterExercise {
  peso_corporal
  polea
  barra
  asistido
  pelota_pilates
  cuerda
  rodillo
  maquina_palanca
  mancuernas
  stationary_bike
  eliptica
  escaladora
  balon_medicinal
  banda_elastica
}

enum MuscleGroups {
  Piernas
  Cuadriceps
  Gemelos
  Espalda
  Dorsales
  Pecho
  Pectorales
  Gluteos
  Abdominales
  Cardio
  Hombros
  Espalda_alta
  Biceps
  Brazos
  Triceps
  Aductores
  Deltoides
  Core
  Isquiotibiales
  Columna
  Cuello
  Antebrazos
  Trapecios
}
